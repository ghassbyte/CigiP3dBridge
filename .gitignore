# =====================================================================
#  .gitignore
# ---------------------------------------------------------------------
#  Keep build artefacts and IDE noise out of the repo so the only
#  thing that gets committed is the source tree under .\src\ plus the
#  project files at the root. The two .\external\ SDK folders
#  (npcap-sdk-1.16 and UIPC64_SDK_C_version2) are git-kept -- they
#  make the project self-contained for new clones. If your team has a
#  different policy and treats the SDKs as external, drop a `!` line
#  in front of the matching entries below.
# =====================================================================

# ----- Visual Studio build output -------------------------------------
# Anything VS produces that's reproducible from the source.
x64/
*.user
*.suo
*.sdf
*.opensdf
*.cachefile
*.VC.db
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.idb
*.pdb
*.ipdb
*.iobj
*.exp
*.ilk
*.lib
*.obj
*.pch
*.res

# VS Code / Rider / other IDEs
.vs/
.idea/
.vscode/
*.swp
*.swo

# ----- Build artefacts generated by the toolchain ---------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]est[Rr]esult*/
*.userprefs

# ----- OS noise --------------------------------------------------------
Thumbs.db
.DS_Store
desktop.ini
$RECYCLE.BIN/

# ----- Local secrets / per-machine state ------------------------------
# Add patterns here for files that should never be committed:
# credentials, capture files you don't want to share, etc.
*.local
.env
.env.*

# ----- Captured CIGI traffic -------------------------------------------
# .bin files are large and capture-specific; ignore by default.
# Drop the leading `#` if your workflow wants to commit them.
*.bin
*.pcap
*.pcapng


# Editor autosave files (vim/emacs/etc.)
*~
#~

